# Google Cloud / Vertex AI settings
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_GENAI_MODEL=gemini-2.0-flash

# Agent runtime and discovery
AGENT_RUNTIME=cloud-run
A2A_DISCOVERY_URL=https://your-agent-discovery-endpoint
A2A_BASE_URL=https://your-agent-base-url

# Identity and deployment
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
WORKLOAD_IDENTITY_PROVIDER=projects/your-project-number/locations/global/workloadIdentityPools/your-pool/providers/your-provider
SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project-id.iam.gserviceaccount.com

# Optional integrations
VERTEX_AI_SEARCH_DATASTORE_ID=your-vertex-ai-search-datastore-id
VERTEX_AI_SEARCH_LOCATION=global
GOOGLE_MAPS_API_KEY=
GOOGLE_SEARCH_API_KEY=

# Optional configurations
# LOG_LEVEL="INFO"
